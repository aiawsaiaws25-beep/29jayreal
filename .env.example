# ==============================================================================
# JAY REAL ESTATE - NEON DATABASE CONFIGURATION
# ==============================================================================
# 
# 1. Sign up or log into Neon at https://neon.tech
# 2. Create a new PostgreSQL project (e.g. "jay-real-estate")
# 3. Copy your Connection String from your Neon Dashboard:
#    (Looks like: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require)
# 4. Paste it below for DATABASE_URL:
#
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pool-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Server Port
PORT=3001
NODE_ENV=development
